# AdjaraPoker Bot - environment template
# Copy this file to `.env` and fill in your real values.
# The `.env` file is gitignored and must never be committed.

ADJARABET_USERNAME=your_username
ADJARABET_PASSWORD=your_password
TABLE_LIMIT=NL10
PROXY_SERVER=socks5://185.181.8.135:1080
HEADLESS=false
AUTO_PLAY=false
DEBUG=false
# true = open browser at adjarabet.am and log in manually (recommended)
MANUAL_LOGIN=true
